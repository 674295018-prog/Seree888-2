{
  "name": "toy-car-booking-api",
  "version": "1.0.0",
  "description": "Toy Car Booking & Fleet Management API on Cloudflare Workers & D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "d1:migrate:local": "wrangler d1 migrations apply toy_car_db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply toy_car_db --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  }
}
